COMPOSE_PROJECT_NAME=sglab
APP_PORT=8080
APP_HTTPS_PORT=443
# cambiar las ip a la ip de la maquina donde se va a levantar el proyecto
SGLAB_HTTPS_ORIGIN=https://192.168.50.83
DB_BIND_PORT=3306
# Base de datos
DB_NAME=sglab

# Credencial administrativa de MariaDB
DB_ROOT_PASSWORD=root

# Cuenta destinada a la ingesta de diagnósticos/TOML
DB_INGEST_USER=sglab_ingest
DB_INGEST_PASSWORD=tec20206!

# Cuenta destinada a respaldos
DB_BACKUP_USER=sglab_backup
DB_BACKUP_PASSWORD=sglabtec2026!

DB_APP_USER=sglab_app
DB_APP_PASSWORD=tecnicatura2026!

# Ventana de confianza de la detección de PC por IP (1 a 24 horas)
SGLAB_PC_IP_MAX_AGE_HOURS=8

# OAuth App de GitHub: completar en .env cuando se registre la app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://192.168.50.83/?page=github_callback
