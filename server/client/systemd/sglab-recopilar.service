[Unit]
Description=SGLAB - Recopilar y enviar una captura al arrancar
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# root permite leer la identidad DMI sin solicitar sudo en cada arranque.
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/sglab/client/recopilar.py --config /etc/sglab/cliente.json
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
