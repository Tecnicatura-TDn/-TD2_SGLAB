[Unit]
Description=SGLAB - Reintentar el envío de capturas pendientes
After=network-online.target sglab-recopilar.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/sglab/client/recopilar.py --config /etc/sglab/cliente.json --solo-enviar
TimeoutStartSec=30min
